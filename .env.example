# Assista Corp production configuration
NODE_ENV=production
PORT=3000
SESSION_TTL_MS=28800000

# Cloudflare Turnstile
TURNSTILE_SECRET_KEY=

# Transactional email
EMAIL_API_URL=https://api.resend.com/emails
EMAIL_API_KEY=
EMAIL_FROM=Assista Website <website@assistacorp.com>
SALES_EMAIL=sales@assistacorp.com

# Optional trusted proxy configuration
TRUST_PROXY=cloudflare
