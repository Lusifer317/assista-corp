# Never commit the real .env.production file.
NODE_ENV=production
PORT=3000

# Cloudflare Tunnel token. Create a named tunnel and route assistacorp.com to http://assista:3000.
CLOUDFLARE_TUNNEL_TOKEN=replace-with-secret

# Turnstile
TURNSTILE_SECRET_KEY=replace-with-secret
TURNSTILE_EXPECTED_ACTION=contact
TURNSTILE_EXPECTED_HOSTNAME=assistacorp.com
CSP_ALLOW_CLOUDFLARE=true

# Trust only Cloudflare's forwarded client IP header when using the tunnel.
TRUST_PROXY=cloudflare

# Microsoft Graph app registration for sending lead notifications from Outlook/Microsoft 365.
# Grant only Mail.Send application permission and admin consent.
MS_GRAPH_TENANT_ID=replace-with-tenant-id
MS_GRAPH_CLIENT_ID=replace-with-client-id
MS_GRAPH_CLIENT_SECRET=replace-with-secret
MS_GRAPH_SENDER=hr@assistacorp.com
MS_GRAPH_RECIPIENT=sales@assistacorp.com
